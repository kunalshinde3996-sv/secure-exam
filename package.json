{
  "name": "secureexam",
  "version": "1.0.0",
  "description": "SecureExam - secure exam-paper distribution and custody-tracking system backend",
  "main": "dist/index.js",
  "scripts": {
    "dev": "concurrently \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "tsx watch src/index.ts",
    "dev:frontend": "npm run dev --prefix frontend",
    "build": "tsc",
    "start": "node dist/index.js",
    "test:chain": "tsx src/scripts/testChain.ts",
    "seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.5.5",
    "@types/pg": "^8.23.1",
    "concurrently": "^10.0.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
